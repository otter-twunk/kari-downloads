{
  "id": "karinauts.downloaders.just-the-gays-tv",
  "name": "JustTheGays.tv Downloader",
  "version": "0.1.0",
  "description": "Downloads video scenes and clips with inline metadata from justthegays.tv.",
  "author": "Kari",
  "url": "https://github.com/otter-twunk/kari-downloads",
  "categories": [
    "downloader",
    "video",
    "metadata"
  ],
  "minCoveVersion": "1.6.0",
  "entryDll": "JustTheGaysTvDownloader.dll",
  "dependencies": {},
  "permissions": {
    "network": [
      "justthegays.tv",
      "*.justthegays.tv",
      "gff.network",
      "*.gff.network",
      "jtg.network",
      "*.jtg.network"
    ],
    "process": [
      "ffmpeg"
    ],
    "scraperRuntime": [],
    "downloaderRuntime": [
      "justthegays.tv",
      "*.justthegays.tv",
      "gff.network",
      "*.gff.network",
      "jtg.network",
      "*.jtg.network"
    ]
  },
  "externalDependencies": [
    {
      "id": "ffmpeg",
      "name": "FFmpeg",
      "description": "Optional FFmpeg binary used to remux JustTheGays.tv HLS transport streams into MP4 files.",
      "required": false,
      "configurationKeys": [
        "ffmpegPath"
      ]
    }
  ],
  "settings": [
    {
      "name": "ffmpegPath",
      "displayName": "FFmpeg executable path",
      "type": "STRING",
      "description": "Path to ffmpeg executable (defaults to ffmpeg on PATH when omitted)."
    }
  ]
}
